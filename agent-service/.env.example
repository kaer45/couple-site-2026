# ============================================================
# Agent 服务配置模板
# 用法：cp .env.example .env 然后填写真实值
# .env 已被仓库根 .gitignore 忽略（规则 ".env" 不带前导斜杠，对任意层级生效）
# ============================================================

# ---------- 服务自身 ----------
# 必须与 Java 侧 backend/src/main/resources/application.yml 的 agent.key 一致，
# 否则所有请求都会 401。生产环境务必改掉。
AGENT_KEY=change-me

# 监听地址。Java 默认 agent.url=http://localhost:8001
HOST=127.0.0.1
PORT=8001

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- LLM（DeepSeek）----------
# 变量名由 hello-agents 的 HelloAgentsLLM 直接读取，不要改名。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=sk-请填写
# 单次调用超时（秒）。契约要求 /v1/summarize 整体 60s 内返回，别设得比 60 大。
LLM_TIMEOUT=60

# ---------- 嵌入（DashScope text-embedding-v3）----------
DASHSCOPE_API_KEY=sk-请填写
# 给了 base_url 就走 OpenAI 兼容 REST（内部用 requests），不需要安装 dashscope SDK。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL_NAME=text-embedding-v3
# ⚠️ 必须与模型实际维度一致。框架的 QdrantVectorStore 默认 384，不改就会静默丢向量。
#    text-embedding-v3 默认 1024。
EMBED_DIM=1024

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 单次向量操作超时（秒）
QDRANT_TIMEOUT=30

# ---------- SQLite（会话历史）----------
SQLITE_PATH=./data/agent.db

# ---------- 向量检索 ----------
RETRIEVAL_ENABLED=true
RETRIEVAL_TOP_K=4
# 余弦相似度阈值，低于此值的结果不注入上下文。0 表示不过滤。
RETRIEVAL_SCORE_THRESHOLD=0.35

# ---------- 多轮会话 ----------
# 契约 §2.3 建议：保留 10 条、24h 过期
SESSION_MAX_TURNS=10
SESSION_TTL_HOURS=24

# ---------- 离线 mock ----------
# true 时不调用任何外部服务：假流式回答 + 确定性假嵌入 + 内存向量库。
# 用途：没有 API key 或没有网络时，先验证 Java ↔ Python 的协议是否打通。
# ⚠️ 仅供联调，生产必须 false。
AGENT_MOCK=false
