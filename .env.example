# ============================================================
# 复制为 .env 并修改所有密码/密钥后再启动
#   cp .env.example .env
# 注意: .env 包含敏感信息，已被 .gitignore 排除，不要提交到仓库
# ============================================================

# MySQL root 密码（必改）
MYSQL_ROOT_PASSWORD=please-change-root-password

# 业务库名与专用账号（可保持默认）
MYSQL_DATABASE=couple
MYSQL_USER=couple
MYSQL_PASSWORD=please-change-db-password

# JWT 签名密钥（必改，至少 32 位随机字符串，可用 openssl rand -base64 32 生成）
JWT_SECRET=please-change-me-to-a-long-random-string-at-least-32-chars

# JWT 有效期（毫秒，默认 7 天）
JWT_EXPIRATION=604800000

# 允许跨域的前端地址（生产同源部署时无需修改）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== AI Agent（Python 服务，可选）=====
# true = 后端启用调用 Python 的向量检索/对话；未部署 Python 服务时请保持 false
# （注意：application.yml 中代码默认值为 true，Docker 部署默认关闭，避免无谓的调用失败日志）
AGENT_ENABLED=false
# Python 服务地址：后端跑在宿主机时用 http://localhost:8001；
# 后端跑在容器里、Python 跑在宿主机时用 http://host.docker.internal:8001
AGENT_URL=http://host.docker.internal:8001
# 两侧共享密钥，须与 Python 端校验的 X-Agent-Key 一致，生产必改
AGENT_KEY=change-me
